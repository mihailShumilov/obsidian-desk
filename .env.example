# ObsidianDesk environment template.
# Copy to `.env.local` (Next.js) and `.env` (keeper) as needed.
# Variables prefixed `NEXT_PUBLIC_` are inlined into the browser bundle.

# ── Solana ────────────────────────────────────────────────────────────
# RPC endpoint the frontend's wallet adapter and the keeper connect to.
# Default: the local validator on the project's non-standard port 18899.
NEXT_PUBLIC_SOLANA_RPC=http://127.0.0.1:18899
ANCHOR_PROVIDER_URL=http://127.0.0.1:18899
ANCHOR_WALLET=~/.config/solana/id.json

# obsidian-core program id — pinned in Anchor.toml + lib.rs declare_id!.
NEXT_PUBLIC_OBSIDIAN_PROGRAM_ID=H25yY5o4emorZ9qMHAUvJhdtrFjDSeYy2MVYurpQbeLp
OBSIDIAN_PROGRAM_ID=H25yY5o4emorZ9qMHAUvJhdtrFjDSeYy2MVYurpQbeLp

# Network label rendered in the header chip.
NEXT_PUBLIC_NETWORK=devnet

# ── Bitcoin (signet) ──────────────────────────────────────────────────
# esplora-style API base for the /deposit balance poll. Override to a
# self-hosted instance to dodge mempool.space rate limits during demos.
OBSIDIAN_ESPLORA_URL=https://mempool.space/signet/api

# ── Encrypt + Ika SDKs ────────────────────────────────────────────────
# `mock` (default) — in-process FHE / DKG simulation. Deterministic,
# offline, plaintext-recoverable. Suitable for unit tests and offline UI.
# `real` — dispatches to the upstream pre-alpha gRPC services on Solana
# devnet. Encrypt: pre-alpha-dev-1.encrypt.ika-network.net:443. Ika:
# pre-alpha-dev-1.ika.ika-network.net:443. Real-mode is wired via a
# `pnpm patch` on @encrypt.xyz/pre-alpha-solana-client@0.1.1 and a
# vendored copy of the Ika gRPC client at sdk/src/ika-vendor/ — see
# docs/gaps.md (E5 + I0 closed). Verified by
# `node sdk/scripts/devnet-smoke.mjs`.
OBSIDIAN_ENCRYPT_MODE=mock
OBSIDIAN_IKA_MODE=mock
# OBSIDIAN_ENCRYPT_GRPC_URL=pre-alpha-dev-1.encrypt.ika-network.net:443
# OBSIDIAN_ENCRYPT_PROGRAM_ID=4ebfzWdKnrnGseuQpezXdG8yCdHqwQ1SSBHD3bWArND8
# OBSIDIAN_IKA_GRPC_URL=pre-alpha-dev-1.ika.ika-network.net:443

# ── Keeper ────────────────────────────────────────────────────────────
# Polling interval (ms). 3000 is the demo default; raise on devnet to
# avoid burning RPC quota.
KEEPER_POLL_MS=3000
# HTTP /status endpoint port (non-standard to avoid Docker collisions).
KEEPER_PORT=13001
# Default BTC fee rate (sat/vB) for settlement transactions.
KEEPER_FEERATE=4
# Set to any truthy string to enable verbose mock-store debug logging.
# KEEPER_DEBUG=1

# ── Docker compose (P10) ──────────────────────────────────────────────
# Inside docker-compose.yml the keeper hits the validator over the
# docker network alias `solana-validator` (port 8899 inside, 18899 on
# the host). The browser still uses the host port via NEXT_PUBLIC_SOLANA_RPC
# above — the wallet adapter runs in the user's browser, not the container.
SOLANA_RPC=http://solana-validator:8899

# Path on the HOST to a Solana keypair JSON the keeper will use to sign
# finalize_settlement / fail_settlement txs. Mounted via docker secrets
# at /run/secrets/keeper_keypair.json inside the keeper container.
# Default scripts/.keeper-keypair.json is generated by docker-bootstrap.sh
# if absent. NEVER commit a real keypair.
KEEPER_KEYPAIR_PATH=./scripts/.keeper-keypair.json

# Image tag pulled by docker-compose.prod.yml. Set to a commit sha or
# semver in CI; defaults to `latest` for local prod-overlay testing.
IMAGE_TAG=latest
