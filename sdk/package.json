{
  "name": "@obsidian-desk/sdk",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./encrypt": {
      "types": "./dist/encrypt.d.ts",
      "import": "./dist/encrypt.js"
    },
    "./ika": {
      "types": "./dist/ika.d.ts",
      "import": "./dist/ika.js"
    },
    "./btc": {
      "types": "./dist/btc.d.ts",
      "import": "./dist/btc.js"
    },
    "./errors": {
      "types": "./dist/errors.d.ts",
      "import": "./dist/errors.js"
    }
  },
  "scripts": {
    "build": "tsc -p .",
    "typecheck": "tsc -p . --noEmit",
    "test": "node --test --experimental-strip-types --no-warnings tests/*.test.ts",
    "clean": "rm -rf dist"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "5.9.2"
  },
  "dependencies": {
    "bitcoinjs-lib": "^7.0.1",
    "ecpair": "^3.0.1",
    "tiny-secp256k1": "^2.2.4"
  }
}
