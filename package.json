{
  "name": "obsidian-desk",
  "private": true,
  "version": "0.1.0",
  "description": "Institutional dark pool on Solana with FHE-matched orderbook (Encrypt) and native BTC settlement (Ika dWallets).",
  "packageManager": "pnpm@9.15.4",
  "engines": {
    "node": ">=24",
    "pnpm": ">=9"
  },
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "dev": "pnpm -F app -F keeper -r --parallel dev",
    "dev:local": "pnpm -F app -F keeper -r --parallel dev",
    "anchor:build": "anchor build",
    "anchor:test": "anchor test",
    "cargo:check": "cargo check --workspace",
    "cargo:clippy": "cargo clippy --workspace --all-targets -- -D warnings",
    "test:sdk": "pnpm -F @obsidian-desk/sdk test",
    "test": "pnpm -r test",
    "seed:demo": "pnpm exec tsx scripts/seed-demo.ts",
    "deploy:devnet": "anchor deploy --provider.cluster devnet",
    "docker:build": "docker compose build",
    "docker:up": "./scripts/docker-bootstrap.sh",
    "docker:down": "docker compose down -v"
  },
  "devDependencies": {
    "@coral-xyz/anchor": "^0.32.1",
    "@solana/web3.js": "^1.95.0",
    "@types/bn.js": "^5.1.6",
    "@types/chai": "^4.3.20",
    "@types/mocha": "^10.0.10",
    "@types/node": "^22.10.0",
    "bn.js": "^5.2.1",
    "chai": "^4.5.0",
    "mocha": "^10.8.2",
    "ts-mocha": "^11.1.0",
    "ts-node": "^10.9.2",
    "tsx": "^4.19.0",
    "typescript": "5.9.2"
  }
}
